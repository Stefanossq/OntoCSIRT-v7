:MemorySafetyWeakness a owl:Class ;
    rdfs:label "Seguranca de memoria"@pt ;
    rdfs:comment "Ex.: CWE-416, CWE-787, CWE-119, CWE-122, CWE-125, CWE-843. Categoria deste trabalho." ;
    rdfs:subClassOf :Weakness .

:OtherWeakness a owl:Class ;
    rdfs:label "Outra fraqueza"@pt ;
    rdfs:comment "CWE sem categoria propria neste trabalho (ex.: CWE-20 generico). Categoria residual." ;
    rdfs:subClassOf :Weakness .

:RecurrentlyCriticalAsset a owl:Class ;
    rdfs:label "Ativo com incidentes criticos recorrentes"@pt ;
    rdfs:comment "Ativo afetado por dois ou mais incidentes distintos com CVSS >= 9.0 (inferido pela regra R3). Nao confundir com criticidade de negocio." ;
    rdfs:subClassOf :Asset .

:candidateSolution a owl:ObjectProperty ;
    rdfs:label "solucao candidata"@pt ;
    rdfs:comment "Inferida por R6: solucao de um caso cujo problema partilha a fraqueza." ;
    rdfs:domain :Incident ;
    rdfs:range :ResolutionAction .

:hasAttribute a owl:ObjectProperty ;
    rdfs:label "tem atributo"@pt ;
    rdfs:comment "VERIS: atributo CIA afetado." ;
    rdfs:domain :Incident ;
    rdfs:range :SecurityState .

:hasProblem a owl:ObjectProperty ;
    rdfs:label "tem problema"@pt ;
    rdfs:domain :Case ;
    rdfs:range :Incident .

:hasSolution a owl:ObjectProperty ;
    rdfs:label "tem solucao"@pt ;
    rdfs:domain :Case ;
    rdfs:range :ResolutionAction .

:isAssetOf a owl:ObjectProperty ;
    rdfs:label "e ativo de"@pt ;
    rdfs:domain :Asset ;
    rdfs:range :Incident .

:sharesActorWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "partilha ator com"@pt ;
    rdfs:comment "Inferida por R4 (mesmo ator concreto)." ;
    rdfs:domain :Incident ;
    rdfs:range :Incident .

:Actor_APT_B a :ExternalActor ;
    rdfs:label "Grupo APT-B (externo, espionagem, ficticio)" .

:CWE_287 a :AuthenticationWeakness ;
    rdfs:label "CWE-287 Improper Authentication" ;
    :cweId "CWE-287" .

:CWE_502 a :ResourceHandlingWeakness ;
    rdfs:label "CWE-502 Deserialization of Untrusted Data" ;
    :cweId "CWE-502" .

