:actor a swrl:Variable .

:hasActor a owl:ObjectProperty ;
    rdfs:label "tem ator"@pt ;
    rdfs:comment "VERIS: quem realizou." ;
    rdfs:domain :Incident ;
    rdfs:range :ThreatActor .

:hasAsset a owl:ObjectProperty ;
    rdfs:label "tem ativo"@pt ;
    rdfs:comment "VERIS: ativo afetado." ;
    rdfs:domain :Incident ;
    rdfs:range :Asset ;
    owl:inverseOf :isAssetOf .

:hasWeakness a owl:ObjectProperty ;
    rdfs:label "tem fraqueza"@pt ;
    rdfs:domain :Vulnerability ;
    rdfs:range :Weakness .

:j a swrl:Variable .

:s1 a swrl:Variable .

:s2 a swrl:Variable .

:sharesWeaknessWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "partilha fraqueza com"@pt ;
    rdfs:comment "Inferida por R5 (mesma CWE)." ;
    rdfs:domain :Incident ;
    rdfs:range :Incident .

:sol a swrl:Variable .

:w a swrl:Variable .

:Actor_FIN_A a :ExternalActor ;
    rdfs:label "Grupo FIN-A (externo, motivacao financeira, ficticio)" .

:Asset_Server_1 a :Server ;
    rdfs:label "Servidor 1" .

:CoA_Isolate a :ResolutionAction ;
    rdfs:label "Isolar o ativo" .

:Database a owl:Class ;
    rdfs:label "Base de dados"@pt ;
    rdfs:comment "Servidor de base de dados." ;
    rdfs:subClassOf :Asset .

:InternalActor a owl:Class ;
    rdfs:label "Ator interno"@pt ;
    :verisCategory "actor.Internal" ;
    rdfs:comment "Ator da propria organizacao (VERIS actor.Internal)." ;
    rdfs:subClassOf :ThreatActor .

:PartnerActor a owl:Class ;
    rdfs:label "Ator parceiro"@pt ;
    :verisCategory "actor.Partner" ;
    rdfs:comment "Ator de terceiro com relacao de negocio (VERIS actor.Partner)." ;
    rdfs:subClassOf :ThreatActor .

:RequestForgeryWeakness a owl:Class ;
    rdfs:label "Falsificacao de requisicao no servidor"@pt ;
    rdfs:comment "CWE-918." ;
    rdfs:subClassOf :Weakness .

:Workstation a owl:Class ;
    rdfs:label "Estacao de trabalho"@pt ;
    rdfs:comment "Equipamento de usuario final." ;
    rdfs:subClassOf :Asset .

:c a swrl:Variable .

:AuthenticationWeakness a owl:Class ;
    rdfs:label "Autenticacao"@pt ;
    rdfs:comment "CWE-287, CWE-798." ;
    rdfs:subClassOf :Weakness .

:CoA_Patch a :ResolutionAction ;
    rdfs:label "Aplicar correcao (patch)" .

:CoA_WAFRule a :ResolutionAction ;
    rdfs:label "Implantar regra de firewall/WAF" .

:UnknownActor a owl:Class ;
    rdfs:label "Ator desconhecido"@pt ;
    :verisCategory "actor.Unknown" ;
    rdfs:comment "Ator nao identificado na fonte (VERIS actor.Unknown)." ;
    rdfs:subClassOf :ThreatActor .

:WebClientWeakness a owl:Class ;
    rdfs:label "Fraqueza do lado do cliente web"@pt ;
    rdfs:comment "CWE-79, CWE-352." ;
    rdfs:subClassOf :Weakness .

:a a swrl:Variable .

:v1 a swrl:Variable .

:v2 a swrl:Variable .

:AccessControlWeakness a owl:Class ;
    rdfs:label "Controle de acesso"@pt ;
    rdfs:comment "CWE-639, CWE-862." ;
    rdfs:subClassOf :Weakness .

:DetectionSource a owl:Class ;
    rdfs:label "Fonte de deteccao"@pt ;
    rdfs:comment "IDS, EDR, SIEM." .

:ExternalActor a owl:Class ;
    rdfs:label "Ator externo"@pt ;
    :verisCategory "actor.External" ;
    rdfs:comment "Ator fora da organizacao (VERIS actor.External)." ;
    rdfs:subClassOf :ThreatActor .

:ResourceHandlingWeakness a owl:Class ;
    rdfs:label "Tratamento inseguro de recursos"@pt ;
    rdfs:comment "CWE-22, CWE-434, CWE-502." ;
    rdfs:subClassOf :Weakness .

:SecurityState a owl:Class ;
    rdfs:label "Atributo de seguranca"@pt ;
    :verisCategory "attribute" ;
    rdfs:comment "Propriedade afetada da triade CIA (VERIS: attribute)." .

:hasRiskLevel a owl:DatatypeProperty ;
    rdfs:label "nivel de risco"@pt ;
    rdfs:comment "Derivado do CVSS pelas regras R1a-R1d; valores Critical, High, Medium, Low." ;
    rdfs:domain :Incident ;
    rdfs:range xsd:string .

:InjectionWeakness a owl:Class ;
    rdfs:label "Injecao no servidor"@pt ;
    rdfs:comment "CWE-77, CWE-78, CWE-89." ;
    rdfs:subClassOf :Weakness .

:Server a owl:Class ;
    rdfs:label "Servidor"@pt ;
    rdfs:comment "Servidor de aplicacao." ;
    rdfs:subClassOf :Asset .

:cvssBaseScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "pontuacao base CVSS"@pt ;
    rdfs:comment "CVSS v3.x; funcional (um valor por vulnerabilidade)." ;
    rdfs:domain :Vulnerability ;
    rdfs:range xsd:decimal .

:ThreatActor a owl:Class ;
    rdfs:label "Ator de ameaca"@pt ;
    :stixType "threat-actor" ;
    :verisCategory "actor" ;
    rdfs:comment "Agente concreto que realiza a acao (VERIS: actor)." .

:State_Confidentiality a :SecurityState ;
    rdfs:label "Confidencialidade"@pt .

:involvesVulnerability a owl:ObjectProperty ;
    rdfs:label "envolve vulnerabilidade"@pt ;
    rdfs:domain :Incident ;
    rdfs:range :Vulnerability .

:v a swrl:Variable .

:i2 a swrl:Variable .

:Asset a owl:Class ;
    rdfs:label "Ativo"@pt ;
    :stixType "infrastructure" ;
    :verisCategory "asset" ;
    rdfs:comment "Recurso computacional afetado (VERIS: asset). Correspondencia aproximada com STIX infrastructure." .

:s a swrl:Variable .

:i1 a swrl:Variable .

:ResolutionAction a owl:Class ;
    rdfs:label "Acao de resolucao"@pt ;
    rdfs:comment "Acao concreta registada como solucao de um caso." ;
    rdfs:subClassOf :CourseOfAction .

:Weakness a owl:Class ;
    rdfs:label "Fraqueza"@pt ;
    rdfs:comment "Entrada do catalogo CWE. As subclasses sao categorias definidas NESTE trabalho para similaridade; nao reproduzem a hierarquia oficial da CWE." .

:ThreatAction a owl:Class ;
    rdfs:label "Acao de ameaca"@pt ;
    :verisCategory "action" ;
    rdfs:comment "Acao concreta realizada num incidente (VERIS: action). Instancia um AttackPattern abstrato." .

:i a swrl:Variable .

:Case a owl:Class ;
    rdfs:label "Caso"@pt ;
    rdfs:comment "Caso CBR: par (incidente historico, acao de resolucao registada)." .

:AttackPattern a owl:Class ;
    rdfs:label "Padrao de ataque"@pt ;
    :stixType "attack-pattern" ;
    rdfs:comment "Tipo abstrato de ataque, reutilizavel entre incidentes; nao se liga a ativos concretos." .

:Vulnerability a owl:Class ;
    rdfs:label "Vulnerabilidade"@pt ;
    :stixType "vulnerability" ;
    rdfs:comment "Falha concreta num produto, identificada por CVE quando publica; liga-se a uma fraqueza (CWE)." .

:Incident a owl:Class ;
    rdfs:label "Incident"@en,
        "Incidente"@pt ;
    :stixType "incident" ;
    :verisCategory "incident" ;
    rdfs:comment "Evento de seguranca reificado; liga-se aos quatro eixos VERIS A4: ator, acao, ativo e atributo." .

[] a owl:AllDifferent ;
    owl:distinctMembers ( :Incident_01 :Incident_02 :Incident_03 :Incident_04 :Incident_05 :Incident_06 :Incident_CVE_2025_20337 :Incident_CVE_2025_21480 :Incident_CVE_2025_49706 ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :ExternalActor :InternalActor :PartnerActor ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Server :Database :Gateway :Workstation ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :InjectionWeakness :WebClientWeakness :AccessControlWeakness :AuthenticationWeakness :ResourceHandlingWeakness :RequestForgeryWeakness ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Incident :ThreatActor :ThreatAction :AttackPattern :Asset :SecurityState :Vulnerability :Weakness :DetectionSource :CourseOfAction :Case ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :ExternalActor :InternalActor :PartnerActor :UnknownActor ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :InjectionWeakness :WebClientWeakness :AccessControlWeakness :AuthenticationWeakness :ResourceHandlingWeakness :RequestForgeryWeakness :MemorySafetyWeakness :OtherWeakness ) .

