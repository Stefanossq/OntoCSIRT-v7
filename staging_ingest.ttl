@prefix : <http://www.semanticweb.org/ontocsirt#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

<http://www.semanticweb.org/ontocsirt> a owl:Ontology ;
    rdfs:label "OntoCSIRT v7" ;
    dcterms:created "2026-11-02"^^xsd:date ;
    dcterms:creator "Nome do Aluno" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "Ontologia OWL 2 DL para analise de incidentes de ciberseguranca e recuperacao de casos de resposta: incidente reificado (VERIS A4), vulnerabilidades e fraquezas (CVE/CWE), casos de resolucao e regras SWRL." ;
    owl:priorVersion <http://www.semanticweb.org/ontocsirt/6.0> ;
    owl:versionIRI <http://www.semanticweb.org/ontocsirt/7.0> ;
    owl:versionInfo "7.0" .

:AP_AuthzBypass a :AttackPattern ;
    rdfs:label "Contorno de autorizacao" ;
    :relatedWeakness :CWE_862 .

:AP_CSRF a :AttackPattern ;
    rdfs:label "Falsificacao de requisicao entre sitios" ;
    :relatedWeakness :CWE_352 .

:AP_CredentialAbuse a :AttackPattern ;
    rdfs:label "Abuso de credenciais" ;
    :relatedWeakness :CWE_287,
        :CWE_798 .

:AP_MaliciousUpload a :AttackPattern ;
    rdfs:label "Envio de arquivo malicioso" ;
    :relatedWeakness :CWE_434 .

:AP_PathTraversal a :AttackPattern ;
    rdfs:label "Travessia de diretorio" ;
    :relatedWeakness :CWE_22 .

:Actor_INS_C a :InternalActor ;
    rdfs:label "Funcionario C (interno, ficticio)" .

:Actor_PAR_D a :PartnerActor ;
    rdfs:label "Fornecedor D (parceiro, ficticio)" .

:Asset_Database_2 a :Database ;
    rdfs:label "Base de dados 2" .

:Asset_Server_2 a :Server ;
    rdfs:label "Servidor 2" .

:Asset_Workstation_2 a :Workstation ;
    rdfs:label "Estacao 2" .

:Case_01 a :Case ;
    :hasProblem :Incident_01 ;
    :hasSolution :CoA_Patch .

:Case_02 a :Case ;
    :hasProblem :Incident_02 ;
    :hasSolution :CoA_Patch .

:Case_03 a :Case ;
    :hasProblem :Incident_03 ;
    :hasSolution :CoA_WAFRule .

:Case_04 a :Case ;
    :hasProblem :Incident_04 ;
    :hasSolution :CoA_Isolate .

:Case_05 a :Case ;
    :hasProblem :Incident_05 ;
    :hasSolution :CoA_WAFRule .

:Case_06 a :Case ;
    :hasProblem :Incident_06 ;
    :hasSolution :CoA_Segment .

:Case_CVE_2025_20337 a :Case ;
    :hasProblem :Incident_CVE_2025_20337 ;
    :hasSolution :CoA_Isolate ;
    :kevRequiredAction "Apply mitigations per vendor instructions; follow applicable BOD 22-01 guidance for cloud services; or discontinue use of the product if mitigations are unavailable." ;
    :kevSolution :CoA_ApplyMitigation ;
    :solutionProvenance "policy:cwe-category-v1" .

:Case_CVE_2025_21480 a :Case ;
    :hasProblem :Incident_CVE_2025_21480 ;
    :hasSolution :CoA_AccessControlFix ;
    :kevRequiredAction "Apply mitigations per vendor instructions; follow applicable BOD 22-01 guidance for cloud services; or discontinue use of the product if mitigations are unavailable." ;
    :kevSolution :CoA_ApplyMitigation ;
    :solutionProvenance "policy:cwe-category-v1" .

:Case_CVE_2025_49706 a :Case ;
    :hasProblem :Incident_CVE_2025_49706 ;
    :hasSolution :CoA_RotateCredentials ;
    :kevRequiredAction "Disconnect public-facing versions of SharePoint Server that have reached their end-of-life (EOL) or end-of-service (EOS) to include SharePoint Server 2013 and earlier versions. For supported versions; please follow the mitigations according to CISA (URL listed below in Notes) and vendor instructions (URL listed below in Notes). Adhere to the applicable BOD 22-01 guidance for cloud services or discontinue use of the product if mitigations are not available." ;
    :kevSolution :CoA_Decommission ;
    :solutionProvenance "policy:cwe-category-v1" .

:ConfidentialityAtRisk a owl:Class ;
    rdfs:label "Incidente com risco a confidencialidade"@pt ;
    rdfs:comment "Definida em OWL: incidente cujo atributo afetado inclui a confidencialidade." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Incident [ a owl:Restriction ;
                        owl:hasValue :State_Confidentiality ;
                        owl:onProperty :hasAttribute ] ) ] .

:CriticalRiskIncident a owl:Class ;
    rdfs:label "Incidente de risco critico"@pt ;
    rdfs:comment "Definida em OWL sobre o valor de risco produzido pela regra R1a." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Incident [ a owl:Restriction ;
                        owl:hasValue "Critical" ;
                        owl:onProperty :hasRiskLevel ] ) ] .

:R1a_Critical a swrl:Imp ;
    rdfs:label "R1a - CVSS >= 9.0 implica risco Critical" ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 :i ;
                swrl:classPredicate :Incident ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :i ;
                swrl:argument2 :v ;
                swrl:propertyPredicate :involvesVulnerability ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :v ;
                swrl:argument2 :s ;
                swrl:propertyPredicate :cvssBaseScore ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( :s 9.0 ) ;
                swrl:builtin swrlb:greaterThanOrEqual ] ) ;
    swrl:head ( [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :i ;
                swrl:argument2 "Critical" ;
                swrl:propertyPredicate :hasRiskLevel ] ) .

:R1b_High a swrl:Imp ;
    rdfs:label "R1b - 7.0 <= CVSS < 9.0 implica risco High" ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 :i ;
                swrl:classPredicate :Incident ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :i ;
                swrl:argument2 :v ;
                swrl:propertyPredicate :involvesVulnerability ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :v ;
                swrl:argument2 :s ;
                swrl:propertyPredicate :cvssBaseScore ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( :s 7.0 ) ;
                swrl:builtin swrlb:greaterThanOrEqual ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( :s 9.0 ) ;
                swrl:builtin swrlb:lessThan ] ) ;
    swrl:head ( [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :i ;
                swrl:argument2 "High" ;
                swrl:propertyPredicate :hasRiskLevel ] ) .

:R1c_Medium a swrl:Imp ;
    rdfs:label "R1c - 4.0 <= CVSS < 7.0 implica risco Medium" ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 :i ;
                swrl:classPredicate :Incident ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :i ;
                swrl:argument2 :v ;
                swrl:propertyPredicate :involvesVulnerability ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :v ;
                swrl:argument2 :s ;
                swrl:propertyPredicate :cvssBaseScore ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( :s 4.0 ) ;
                swrl:builtin swrlb:greaterThanOrEqual ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( :s 7.0 ) ;
                swrl:builtin swrlb:lessThan ] ) ;
    swrl:head ( [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :i ;
                swrl:argument2 "Medium" ;
                swrl:propertyPredicate :hasRiskLevel ] ) .

:R1d_Low a swrl:Imp ;
    rdfs:label "R1d - CVSS < 4.0 implica risco Low" ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 :i ;
                swrl:classPredicate :Incident ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :i ;
                swrl:argument2 :v ;
                swrl:propertyPredicate :involvesVulnerability ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :v ;
                swrl:argument2 :s ;
                swrl:propertyPredicate :cvssBaseScore ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( :s 4.0 ) ;
                swrl:builtin swrlb:lessThan ] ) ;
    swrl:head ( [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :i ;
                swrl:argument2 "Low" ;
                swrl:propertyPredicate :hasRiskLevel ] ) .

:R3_RecurrentCritical a swrl:Imp ;
    rdfs:label "R3 - ativo com dois ou mais incidentes criticos distintos" ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 :a ;
                swrl:classPredicate :Asset ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :i1 ;
                swrl:argument2 :a ;
                swrl:propertyPredicate :hasAsset ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :i1 ;
                swrl:argument2 :v1 ;
                swrl:propertyPredicate :involvesVulnerability ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :v1 ;
                swrl:argument2 :s1 ;
                swrl:propertyPredicate :cvssBaseScore ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( :s1 9.0 ) ;
                swrl:builtin swrlb:greaterThanOrEqual ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :i2 ;
                swrl:argument2 :a ;
                swrl:propertyPredicate :hasAsset ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :i2 ;
                swrl:argument2 :v2 ;
                swrl:propertyPredicate :involvesVulnerability ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :v2 ;
                swrl:argument2 :s2 ;
                swrl:propertyPredicate :cvssBaseScore ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( :s2 9.0 ) ;
                swrl:builtin swrlb:greaterThanOrEqual ] [ a swrl:DifferentIndividualsAtom ;
                swrl:argument1 :i1 ;
                swrl:argument2 :i2 ] ) ;
    swrl:head ( [ a swrl:ClassAtom ;
                swrl:argument1 :a ;
                swrl:classPredicate :RecurrentlyCriticalAsset ] ) .

:R4_SharedActor a swrl:Imp ;
    rdfs:label "R4 - incidentes com o mesmo ator concreto" ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 :i1 ;
                swrl:classPredicate :Incident ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :i1 ;
                swrl:argument2 :actor ;
                swrl:propertyPredicate :hasActor ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :i2 ;
                swrl:argument2 :actor ;
                swrl:propertyPredicate :hasActor ] [ a swrl:DifferentIndividualsAtom ;
                swrl:argument1 :i1 ;
                swrl:argument2 :i2 ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :i1 ;
                swrl:argument2 :i2 ;
                swrl:propertyPredicate :sharesActorWith ] ) .

:R5_SharedWeakness a swrl:Imp ;
    rdfs:label "R5 - incidentes com a mesma fraqueza (CWE)" ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 :i1 ;
                swrl:classPredicate :Incident ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :i1 ;
                swrl:argument2 :v1 ;
                swrl:propertyPredicate :involvesVulnerability ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :v1 ;
                swrl:argument2 :w ;
                swrl:propertyPredicate :hasWeakness ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :i2 ;
                swrl:argument2 :v2 ;
                swrl:propertyPredicate :involvesVulnerability ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :v2 ;
                swrl:argument2 :w ;
                swrl:propertyPredicate :hasWeakness ] [ a swrl:DifferentIndividualsAtom ;
                swrl:argument1 :i1 ;
                swrl:argument2 :i2 ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :i1 ;
                swrl:argument2 :i2 ;
                swrl:propertyPredicate :sharesWeaknessWith ] ) .

:R6_CandidateSolution a swrl:Imp ;
    rdfs:label "R6 - solucao de caso com a mesma fraqueza e candidata" ;
    swrl:body ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :i ;
                swrl:argument2 :j ;
                swrl:propertyPredicate :sharesWeaknessWith ] [ a swrl:ClassAtom ;
                swrl:argument1 :c ;
                swrl:classPredicate :Case ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :c ;
                swrl:argument2 :j ;
                swrl:propertyPredicate :hasProblem ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :c ;
                swrl:argument2 :sol ;
                swrl:propertyPredicate :hasSolution ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 :i ;
                swrl:argument2 :sol ;
                swrl:propertyPredicate :candidateSolution ] ) .

:State_Availability a :SecurityState ;
    rdfs:label "Disponibilidade"@pt .

:alertId a owl:DatatypeProperty ;
    rdfs:label "identificador do alerta"@pt ;
    rdfs:domain :Incident ;
    rdfs:range xsd:string .

:assetTypeEvidence a owl:AnnotationProperty ;
    rdfs:label "evidencia do tipo de ativo"@pt .

:attackId a owl:DatatypeProperty ;
    rdfs:label "identificador ATT&CK"@pt ;
    rdfs:domain :AttackPattern ;
    rdfs:range xsd:string .

:confidentialityImpact a owl:DatatypeProperty ;
    rdfs:label "impacto em confidencialidade"@pt ;
    rdfs:comment "Metrica C do vetor CVSS: HIGH, LOW ou NONE." ;
    rdfs:domain :Vulnerability ;
    rdfs:range xsd:string .

:cveId a owl:DatatypeProperty ;
    rdfs:label "identificador CVE"@pt ;
    rdfs:domain :Vulnerability ;
    rdfs:range xsd:string .

:cvssSource a owl:DatatypeProperty ;
    rdfs:label "origem do CVSS"@pt ;
    rdfs:domain :Vulnerability ;
    rdfs:range xsd:string .

:cweId a owl:DatatypeProperty ;
    rdfs:label "identificador CWE"@pt ;
    rdfs:domain :Weakness ;
    rdfs:range xsd:string .

:detectedBy a owl:ObjectProperty ;
    rdfs:label "detectado por"@pt ;
    rdfs:domain :Incident ;
    rdfs:range :DetectionSource .

:exploits a owl:ObjectProperty ;
    rdfs:label "explora"@pt ;
    rdfs:comment "A acao concreta explora a vulnerabilidade concreta." ;
    rdfs:domain :ThreatAction ;
    rdfs:range :Vulnerability .

:hasAction a owl:ObjectProperty ;
    rdfs:label "tem acao"@pt ;
    rdfs:comment "VERIS: o que foi feito (acao concreta)." ;
    rdfs:domain :Incident ;
    rdfs:range :ThreatAction .

:instantiatesPattern a owl:ObjectProperty ;
    rdfs:label "instancia padrao"@pt ;
    rdfs:comment "Liga a acao concreta ao tipo abstrato." ;
    rdfs:domain :ThreatAction ;
    rdfs:range :AttackPattern .

:kevDateAdded a owl:AnnotationProperty ;
    rdfs:label "data de inclusao no KEV"@pt .

:kevRequiredAction a owl:DatatypeProperty ;
    rdfs:label "acao exigida pelo KEV (texto)"@pt ;
    rdfs:domain :Case ;
    rdfs:range xsd:string .

:kevSolution a owl:ObjectProperty ;
    rdfs:label "acao normalizada do KEV"@pt ;
    rdfs:comment "Normalizacao do requiredAction do KEV; guardada a parte para comparacao com a sugestao da politica." ;
    rdfs:domain :Case ;
    rdfs:range :ResolutionAction .

:knownRansomwareUse a owl:DatatypeProperty ;
    rdfs:label "uso conhecido em ransomware (KEV)"@pt ;
    rdfs:domain :Vulnerability ;
    rdfs:range xsd:string .

:mappedTechnique a owl:ObjectProperty ;
    rdfs:label "tecnica mapeada (adicional)"@pt ;
    rdfs:comment "Outras tecnicas de exploracao do mapeamento CTID KEV->ATT&CK, alem da usada na acao." ;
    rdfs:domain :Vulnerability ;
    rdfs:range :AttackPattern .

:mitigatedBy a owl:ObjectProperty ;
    rdfs:label "mitigado por"@pt ;
    rdfs:comment "Acao efetivamente registada para o incidente historico." ;
    rdfs:domain :Incident ;
    rdfs:range :ResolutionAction .

:otherCweIds a owl:AnnotationProperty ;
    rdfs:label "outros CWE listados (separados por espaco)"@pt .

:relatedWeakness a owl:ObjectProperty ;
    rdfs:label "fraqueza relacionada"@pt ;
    rdfs:comment "Fraqueza tipicamente explorada pelo padrao." ;
    rdfs:domain :AttackPattern ;
    rdfs:range :Weakness .

:solutionProvenance a owl:DatatypeProperty ;
    rdfs:label "proveniencia da solucao"@pt ;
    rdfs:comment "De onde vem hasSolution: 'policy:cwe-category-v1' (sugestao derivada da politica) ou 'kev:requiredAction' (normalizacao do texto do KEV). Nunca e um desfecho observado." ;
    rdfs:domain :Case ;
    rdfs:range xsd:string .

:sourceAddress a owl:DatatypeProperty ;
    rdfs:label "endereco de origem"@pt ;
    rdfs:domain :ThreatActor ;
    rdfs:range xsd:string .

:stixType a owl:AnnotationProperty ;
    rdfs:comment "Tipo de objeto STIX 2.1 mais proximo (correspondencia aproximada, nao equivalencia)." .

:vendorProduct a owl:DatatypeProperty ;
    rdfs:label "fornecedor e produto (KEV)"@pt ;
    rdfs:domain :Asset ;
    rdfs:range xsd:string .

:verificationNote a owl:AnnotationProperty ;
    rdfs:comment "Origem e estado de verificacao do dado (aterramento/grounding)." .

:verisCategory a owl:AnnotationProperty ;
    rdfs:comment "Elemento do modelo VERIS A4 ou categoria VERIS correspondente." .

<http://www.semanticweb.org/ontocsirt/ext> a owl:Ontology ;
    rdfs:label "OntoCSIRT v7 - extensao de ingestao (KEV, ATT&CK, NVD) e SOAR" ;
    rdfs:comment "Acrescenta vocabulario de proveniencia; os dados ingeridos nao sao desfechos de incidentes." .

