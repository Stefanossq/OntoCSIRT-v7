@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.semanticweb.org/ontocsirt#> .
@prefix ns2: <http://www.w3.org/2003/11/swrl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

<http://www.semanticweb.org/ontocsirt> a owl:Ontology ;
    rdfs:label "OntoCSIRT v7" ;
    dcterms:created "2026-11-02"^^xsd:date ;
    dcterms:creator "Nome do Aluno" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "Ontologia OWL 2 DL para analise de incidentes de ciberseguranca e recuperacao de casos de resposta: incidente reificado (VERIS A4), vulnerabilidades e fraquezas (CVE/CWE), casos de resolucao e regras SWRL." ;
    owl:priorVersion <http://www.semanticweb.org/ontocsirt/6.0> ;
    owl:versionIRI <http://www.semanticweb.org/ontocsirt/7.0> ;
    owl:versionInfo "7.0" .

ns1:AP_AuthzBypass a ns1:AttackPattern ;
    rdfs:label "Contorno de autorizacao" ;
    ns1:relatedWeakness ns1:CWE_862 .

ns1:AP_CSRF a ns1:AttackPattern ;
    rdfs:label "Falsificacao de requisicao entre sitios" ;
    ns1:relatedWeakness ns1:CWE_352 .

ns1:AP_CredentialAbuse a ns1:AttackPattern ;
    rdfs:label "Abuso de credenciais" ;
    ns1:relatedWeakness ns1:CWE_287,
        ns1:CWE_798 .

ns1:AP_MaliciousUpload a ns1:AttackPattern ;
    rdfs:label "Envio de arquivo malicioso" ;
    ns1:relatedWeakness ns1:CWE_434 .

ns1:AP_PathTraversal a ns1:AttackPattern ;
    rdfs:label "Travessia de diretorio" ;
    ns1:relatedWeakness ns1:CWE_22 .

ns1:Actor_INS_C a ns1:InternalActor ;
    rdfs:label "Funcionario C (interno, ficticio)" .

ns1:Actor_PAR_D a ns1:PartnerActor ;
    rdfs:label "Fornecedor D (parceiro, ficticio)" .

ns1:Asset_Database_2 a ns1:Database ;
    rdfs:label "Base de dados 2" .

ns1:Asset_Server_2 a ns1:Server ;
    rdfs:label "Servidor 2" .

ns1:Asset_Workstation_2 a ns1:Workstation ;
    rdfs:label "Estacao 2" .

ns1:Case_01 a ns1:Case ;
    ns1:hasProblem ns1:Incident_01 ;
    ns1:hasSolution ns1:CoA_Patch .

ns1:Case_02 a ns1:Case ;
    ns1:hasProblem ns1:Incident_02 ;
    ns1:hasSolution ns1:CoA_Patch .

ns1:Case_03 a ns1:Case ;
    ns1:hasProblem ns1:Incident_03 ;
    ns1:hasSolution ns1:CoA_WAFRule .

ns1:Case_04 a ns1:Case ;
    ns1:hasProblem ns1:Incident_04 ;
    ns1:hasSolution ns1:CoA_Isolate .

ns1:Case_05 a ns1:Case ;
    ns1:hasProblem ns1:Incident_05 ;
    ns1:hasSolution ns1:CoA_WAFRule .

ns1:Case_06 a ns1:Case ;
    ns1:hasProblem ns1:Incident_06 ;
    ns1:hasSolution ns1:CoA_Segment .

ns1:Case_CVE_2025_20337 a ns1:Case ;
    ns1:hasProblem ns1:Incident_CVE_2025_20337 ;
    ns1:hasSolution ns1:CoA_Isolate ;
    ns1:kevRequiredAction "Apply mitigations per vendor instructions; follow applicable BOD 22-01 guidance for cloud services; or discontinue use of the product if mitigations are unavailable." ;
    ns1:kevSolution ns1:CoA_ApplyMitigation ;
    ns1:solutionProvenance "policy:cwe-category-v1" .

ns1:Case_CVE_2025_21480 a ns1:Case ;
    ns1:hasProblem ns1:Incident_CVE_2025_21480 ;
    ns1:hasSolution ns1:CoA_AccessControlFix ;
    ns1:kevRequiredAction "Apply mitigations per vendor instructions; follow applicable BOD 22-01 guidance for cloud services; or discontinue use of the product if mitigations are unavailable." ;
    ns1:kevSolution ns1:CoA_ApplyMitigation ;
    ns1:solutionProvenance "policy:cwe-category-v1" .

ns1:Case_CVE_2025_49706 a ns1:Case ;
    ns1:hasProblem ns1:Incident_CVE_2025_49706 ;
    ns1:hasSolution ns1:CoA_RotateCredentials ;
    ns1:kevRequiredAction "Disconnect public-facing versions of SharePoint Server that have reached their end-of-life (EOL) or end-of-service (EOS) to include SharePoint Server 2013 and earlier versions. For supported versions; please follow the mitigations according to CISA (URL listed below in Notes) and vendor instructions (URL listed below in Notes). Adhere to the applicable BOD 22-01 guidance for cloud services or discontinue use of the product if mitigations are not available." ;
    ns1:kevSolution ns1:CoA_Decommission ;
    ns1:solutionProvenance "policy:cwe-category-v1" .

ns1:ConfidentialityAtRisk a owl:Class ;
    rdfs:label "Incidente com risco a confidencialidade"@pt ;
    rdfs:comment "Definida em OWL: incidente cujo atributo afetado inclui a confidencialidade." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Incident [ a owl:Restriction ;
                        owl:hasValue ns1:State_Confidentiality ;
                        owl:onProperty ns1:hasAttribute ] ) ] .

ns1:CriticalRiskIncident a owl:Class ;
    rdfs:label "Incidente de risco critico"@pt ;
    rdfs:comment "Definida em OWL sobre o valor de risco produzido pela regra R1a." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Incident [ a owl:Restriction ;
                        owl:hasValue "Critical" ;
                        owl:onProperty ns1:hasRiskLevel ] ) ] .

ns1:R1a_Critical a ns2:Imp ;
    rdfs:label "R1a - CVSS >= 9.0 implica risco Critical" ;
    ns2:body ( [ a ns2:ClassAtom ;
                ns2:argument1 ns1:i ;
                ns2:classPredicate ns1:Incident ] [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:i ;
                ns2:argument2 ns1:v ;
                ns2:propertyPredicate ns1:involvesVulnerability ] [ a ns2:DatavaluedPropertyAtom ;
                ns2:argument1 ns1:v ;
                ns2:argument2 ns1:s ;
                ns2:propertyPredicate ns1:cvssBaseScore ] [ a ns2:BuiltinAtom ;
                ns2:arguments ( ns1:s 9.0 ) ;
                ns2:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual> ] ) ;
    ns2:head ( [ a ns2:DatavaluedPropertyAtom ;
                ns2:argument1 ns1:i ;
                ns2:argument2 "Critical" ;
                ns2:propertyPredicate ns1:hasRiskLevel ] ) .

ns1:R1b_High a ns2:Imp ;
    rdfs:label "R1b - 7.0 <= CVSS < 9.0 implica risco High" ;
    ns2:body ( [ a ns2:ClassAtom ;
                ns2:argument1 ns1:i ;
                ns2:classPredicate ns1:Incident ] [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:i ;
                ns2:argument2 ns1:v ;
                ns2:propertyPredicate ns1:involvesVulnerability ] [ a ns2:DatavaluedPropertyAtom ;
                ns2:argument1 ns1:v ;
                ns2:argument2 ns1:s ;
                ns2:propertyPredicate ns1:cvssBaseScore ] [ a ns2:BuiltinAtom ;
                ns2:arguments ( ns1:s 7.0 ) ;
                ns2:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual> ] [ a ns2:BuiltinAtom ;
                ns2:arguments ( ns1:s 9.0 ) ;
                ns2:builtin <http://www.w3.org/2003/11/swrlb#lessThan> ] ) ;
    ns2:head ( [ a ns2:DatavaluedPropertyAtom ;
                ns2:argument1 ns1:i ;
                ns2:argument2 "High" ;
                ns2:propertyPredicate ns1:hasRiskLevel ] ) .

ns1:R1c_Medium a ns2:Imp ;
    rdfs:label "R1c - 4.0 <= CVSS < 7.0 implica risco Medium" ;
    ns2:body ( [ a ns2:ClassAtom ;
                ns2:argument1 ns1:i ;
                ns2:classPredicate ns1:Incident ] [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:i ;
                ns2:argument2 ns1:v ;
                ns2:propertyPredicate ns1:involvesVulnerability ] [ a ns2:DatavaluedPropertyAtom ;
                ns2:argument1 ns1:v ;
                ns2:argument2 ns1:s ;
                ns2:propertyPredicate ns1:cvssBaseScore ] [ a ns2:BuiltinAtom ;
                ns2:arguments ( ns1:s 4.0 ) ;
                ns2:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual> ] [ a ns2:BuiltinAtom ;
                ns2:arguments ( ns1:s 7.0 ) ;
                ns2:builtin <http://www.w3.org/2003/11/swrlb#lessThan> ] ) ;
    ns2:head ( [ a ns2:DatavaluedPropertyAtom ;
                ns2:argument1 ns1:i ;
                ns2:argument2 "Medium" ;
                ns2:propertyPredicate ns1:hasRiskLevel ] ) .

ns1:R1d_Low a ns2:Imp ;
    rdfs:label "R1d - CVSS < 4.0 implica risco Low" ;
    ns2:body ( [ a ns2:ClassAtom ;
                ns2:argument1 ns1:i ;
                ns2:classPredicate ns1:Incident ] [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:i ;
                ns2:argument2 ns1:v ;
                ns2:propertyPredicate ns1:involvesVulnerability ] [ a ns2:DatavaluedPropertyAtom ;
                ns2:argument1 ns1:v ;
                ns2:argument2 ns1:s ;
                ns2:propertyPredicate ns1:cvssBaseScore ] [ a ns2:BuiltinAtom ;
                ns2:arguments ( ns1:s 4.0 ) ;
                ns2:builtin <http://www.w3.org/2003/11/swrlb#lessThan> ] ) ;
    ns2:head ( [ a ns2:DatavaluedPropertyAtom ;
                ns2:argument1 ns1:i ;
                ns2:argument2 "Low" ;
                ns2:propertyPredicate ns1:hasRiskLevel ] ) .

ns1:R3_RecurrentCritical a ns2:Imp ;
    rdfs:label "R3 - ativo com dois ou mais incidentes criticos distintos" ;
    ns2:body ( [ a ns2:ClassAtom ;
                ns2:argument1 ns1:a ;
                ns2:classPredicate ns1:Asset ] [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:i1 ;
                ns2:argument2 ns1:a ;
                ns2:propertyPredicate ns1:hasAsset ] [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:i1 ;
                ns2:argument2 ns1:v1 ;
                ns2:propertyPredicate ns1:involvesVulnerability ] [ a ns2:DatavaluedPropertyAtom ;
                ns2:argument1 ns1:v1 ;
                ns2:argument2 ns1:s1 ;
                ns2:propertyPredicate ns1:cvssBaseScore ] [ a ns2:BuiltinAtom ;
                ns2:arguments ( ns1:s1 9.0 ) ;
                ns2:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual> ] [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:i2 ;
                ns2:argument2 ns1:a ;
                ns2:propertyPredicate ns1:hasAsset ] [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:i2 ;
                ns2:argument2 ns1:v2 ;
                ns2:propertyPredicate ns1:involvesVulnerability ] [ a ns2:DatavaluedPropertyAtom ;
                ns2:argument1 ns1:v2 ;
                ns2:argument2 ns1:s2 ;
                ns2:propertyPredicate ns1:cvssBaseScore ] [ a ns2:BuiltinAtom ;
                ns2:arguments ( ns1:s2 9.0 ) ;
                ns2:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual> ] [ a ns2:DifferentIndividualsAtom ;
                ns2:argument1 ns1:i1 ;
                ns2:argument2 ns1:i2 ] ) ;
    ns2:head ( [ a ns2:ClassAtom ;
                ns2:argument1 ns1:a ;
                ns2:classPredicate ns1:RecurrentlyCriticalAsset ] ) .

ns1:R4_SharedActor a ns2:Imp ;
    rdfs:label "R4 - incidentes com o mesmo ator concreto" ;
    ns2:body ( [ a ns2:ClassAtom ;
                ns2:argument1 ns1:i1 ;
                ns2:classPredicate ns1:Incident ] [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:i1 ;
                ns2:argument2 ns1:actor ;
                ns2:propertyPredicate ns1:hasActor ] [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:i2 ;
                ns2:argument2 ns1:actor ;
                ns2:propertyPredicate ns1:hasActor ] [ a ns2:DifferentIndividualsAtom ;
                ns2:argument1 ns1:i1 ;
                ns2:argument2 ns1:i2 ] ) ;
    ns2:head ( [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:i1 ;
                ns2:argument2 ns1:i2 ;
                ns2:propertyPredicate ns1:sharesActorWith ] ) .

ns1:R5_SharedWeakness a ns2:Imp ;
    rdfs:label "R5 - incidentes com a mesma fraqueza (CWE)" ;
    ns2:body ( [ a ns2:ClassAtom ;
                ns2:argument1 ns1:i1 ;
                ns2:classPredicate ns1:Incident ] [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:i1 ;
                ns2:argument2 ns1:v1 ;
                ns2:propertyPredicate ns1:involvesVulnerability ] [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:v1 ;
                ns2:argument2 ns1:w ;
                ns2:propertyPredicate ns1:hasWeakness ] [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:i2 ;
                ns2:argument2 ns1:v2 ;
                ns2:propertyPredicate ns1:involvesVulnerability ] [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:v2 ;
                ns2:argument2 ns1:w ;
                ns2:propertyPredicate ns1:hasWeakness ] [ a ns2:DifferentIndividualsAtom ;
                ns2:argument1 ns1:i1 ;
                ns2:argument2 ns1:i2 ] ) ;
    ns2:head ( [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:i1 ;
                ns2:argument2 ns1:i2 ;
                ns2:propertyPredicate ns1:sharesWeaknessWith ] ) .

ns1:R6_CandidateSolution a ns2:Imp ;
    rdfs:label "R6 - solucao de caso com a mesma fraqueza e candidata" ;
    ns2:body ( [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:i ;
                ns2:argument2 ns1:j ;
                ns2:propertyPredicate ns1:sharesWeaknessWith ] [ a ns2:ClassAtom ;
                ns2:argument1 ns1:c ;
                ns2:classPredicate ns1:Case ] [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:c ;
                ns2:argument2 ns1:j ;
                ns2:propertyPredicate ns1:hasProblem ] [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:c ;
                ns2:argument2 ns1:sol ;
                ns2:propertyPredicate ns1:hasSolution ] ) ;
    ns2:head ( [ a ns2:IndividualPropertyAtom ;
                ns2:argument1 ns1:i ;
                ns2:argument2 ns1:sol ;
                ns2:propertyPredicate ns1:candidateSolution ] ) .

ns1:State_Availability a ns1:SecurityState ;
    rdfs:label "Disponibilidade"@pt .

ns1:alertId a owl:DatatypeProperty ;
    rdfs:label "identificador do alerta"@pt ;
    rdfs:domain ns1:Incident ;
    rdfs:range xsd:string .

ns1:assetTypeEvidence a owl:AnnotationProperty ;
    rdfs:label "evidencia do tipo de ativo"@pt .

ns1:attackId a owl:DatatypeProperty ;
    rdfs:label "identificador ATT&CK"@pt ;
    rdfs:domain ns1:AttackPattern ;
    rdfs:range xsd:string .

ns1:confidentialityImpact a owl:DatatypeProperty ;
    rdfs:label "impacto em confidencialidade"@pt ;
    rdfs:comment "Metrica C do vetor CVSS: HIGH, LOW ou NONE." ;
    rdfs:domain ns1:Vulnerability ;
    rdfs:range xsd:string .

ns1:cveId a owl:DatatypeProperty ;
    rdfs:label "identificador CVE"@pt ;
    rdfs:domain ns1:Vulnerability ;
    rdfs:range xsd:string .

ns1:cvssSource a owl:DatatypeProperty ;
    rdfs:label "origem do CVSS"@pt ;
    rdfs:domain ns1:Vulnerability ;
    rdfs:range xsd:string .

ns1:cweId a owl:DatatypeProperty ;
    rdfs:label "identificador CWE"@pt ;
    rdfs:domain ns1:Weakness ;
    rdfs:range xsd:string .

ns1:detectedBy a owl:ObjectProperty ;
    rdfs:label "detectado por"@pt ;
    rdfs:domain ns1:Incident ;
    rdfs:range ns1:DetectionSource .

ns1:exploits a owl:ObjectProperty ;
    rdfs:label "explora"@pt ;
    rdfs:comment "A acao concreta explora a vulnerabilidade concreta." ;
    rdfs:domain ns1:ThreatAction ;
    rdfs:range ns1:Vulnerability .

ns1:hasAction a owl:ObjectProperty ;
    rdfs:label "tem acao"@pt ;
    rdfs:comment "VERIS: o que foi feito (acao concreta)." ;
    rdfs:domain ns1:Incident ;
    rdfs:range ns1:ThreatAction .

ns1:instantiatesPattern a owl:ObjectProperty ;
    rdfs:label "instancia padrao"@pt ;
    rdfs:comment "Liga a acao concreta ao tipo abstrato." ;
    rdfs:domain ns1:ThreatAction ;
    rdfs:range ns1:AttackPattern .

ns1:kevDateAdded a owl:DatatypeProperty ;
    rdfs:label "data de inclusao no KEV"@pt ;
    rdfs:domain ns1:Vulnerability ;
    rdfs:range xsd:date .

ns1:kevRequiredAction a owl:DatatypeProperty ;
    rdfs:label "acao exigida pelo KEV (texto)"@pt ;
    rdfs:domain ns1:Case ;
    rdfs:range xsd:string .

ns1:kevSolution a owl:ObjectProperty ;
    rdfs:label "acao normalizada do KEV"@pt ;
    rdfs:comment "Normalizacao do requiredAction do KEV; guardada a parte para comparacao com a sugestao da politica." ;
    rdfs:domain ns1:Case ;
    rdfs:range ns1:ResolutionAction .

ns1:knownRansomwareUse a owl:DatatypeProperty ;
    rdfs:label "uso conhecido em ransomware (KEV)"@pt ;
    rdfs:domain ns1:Vulnerability ;
    rdfs:range xsd:string .

ns1:mappedTechnique a owl:ObjectProperty ;
    rdfs:label "tecnica mapeada (adicional)"@pt ;
    rdfs:comment "Outras tecnicas de exploracao do mapeamento CTID KEV->ATT&CK, alem da usada na acao." ;
    rdfs:domain ns1:Vulnerability ;
    rdfs:range ns1:AttackPattern .

ns1:mitigatedBy a owl:ObjectProperty ;
    rdfs:label "mitigado por"@pt ;
    rdfs:comment "Acao efetivamente registada para o incidente historico." ;
    rdfs:domain ns1:Incident ;
    rdfs:range ns1:ResolutionAction .

ns1:otherCweIds a owl:AnnotationProperty ;
    rdfs:label "outros CWE listados (separados por espaco)"@pt .

ns1:relatedWeakness a owl:ObjectProperty ;
    rdfs:label "fraqueza relacionada"@pt ;
    rdfs:comment "Fraqueza tipicamente explorada pelo padrao." ;
    rdfs:domain ns1:AttackPattern ;
    rdfs:range ns1:Weakness .

ns1:solutionProvenance a owl:DatatypeProperty ;
    rdfs:label "proveniencia da solucao"@pt ;
    rdfs:comment "De onde vem hasSolution: 'policy:cwe-category-v1' (sugestao derivada da politica) ou 'kev:requiredAction' (normalizacao do texto do KEV). Nunca e um desfecho observado." ;
    rdfs:domain ns1:Case ;
    rdfs:range xsd:string .

ns1:sourceAddress a owl:DatatypeProperty ;
    rdfs:label "endereco de origem"@pt ;
    rdfs:domain ns1:ThreatActor ;
    rdfs:range xsd:string .

ns1:stixType a owl:AnnotationProperty ;
    rdfs:comment "Tipo de objeto STIX 2.1 mais proximo (correspondencia aproximada, nao equivalencia)." .

ns1:vendorProduct a owl:DatatypeProperty ;
    rdfs:label "fornecedor e produto (KEV)"@pt ;
    rdfs:domain ns1:Asset ;
    rdfs:range xsd:string .

ns1:verificationNote a owl:AnnotationProperty ;
    rdfs:comment "Origem e estado de verificacao do dado (aterramento/grounding)." .

ns1:verisCategory a owl:AnnotationProperty ;
    rdfs:comment "Elemento do modelo VERIS A4 ou categoria VERIS correspondente." .

<http://www.semanticweb.org/ontocsirt/ext> a owl:Ontology ;
    rdfs:label "OntoCSIRT v7 - extensao de ingestao (KEV, ATT&CK, NVD) e SOAR" ;
    rdfs:comment "Acrescenta vocabulario de proveniencia; os dados ingeridos nao sao desfechos de incidentes." .

ns1:AP_CommandInjection a ns1:AttackPattern ;
    rdfs:label "Injecao de comandos" ;
    ns1:relatedWeakness ns1:CWE_77,
        ns1:CWE_78 .

ns1:AP_Deserialization a ns1:AttackPattern ;
    rdfs:label "Desserializacao insegura" ;
    ns1:relatedWeakness ns1:CWE_502 .

ns1:AP_IDOR a ns1:AttackPattern ;
    rdfs:label "Referencia direta insegura a objeto" ;
    ns1:relatedWeakness ns1:CWE_639 .

ns1:AP_SQLInjection a ns1:AttackPattern ;
    rdfs:label "Injecao de SQL" ;
    ns1:relatedWeakness ns1:CWE_89 .

ns1:AP_SSRF a ns1:AttackPattern ;
    rdfs:label "Falsificacao de requisicao no servidor" ;
    ns1:relatedWeakness ns1:CWE_918 .

ns1:AP_T1055 a ns1:AttackPattern ;
    rdfs:label "T1055 Process Injection (MITRE ATT&CK)" ;
    dcterms:source <https://attack.mitre.org/techniques/T1055> ;
    ns1:attackId "T1055" .

ns1:AP_T1106 a ns1:AttackPattern ;
    rdfs:label "T1106 Native API (MITRE ATT&CK)" ;
    dcterms:source <https://attack.mitre.org/techniques/T1106> ;
    ns1:attackId "T1106" .

ns1:AP_T1190 a ns1:AttackPattern ;
    rdfs:label "T1190 Exploit Public-Facing Application (MITRE ATT&CK)" ;
    dcterms:source <https://attack.mitre.org/techniques/T1190> ;
    ns1:attackId "T1190" .

ns1:AP_XSS a ns1:AttackPattern ;
    rdfs:label "Cross-site scripting" ;
    ns1:relatedWeakness ns1:CWE_79 .

ns1:Act_01 a ns1:ThreatAction ;
    ns1:exploits ns1:Vuln_CVE_2021_4045 ;
    ns1:instantiatesPattern ns1:AP_CommandInjection .

ns1:Act_02 a ns1:ThreatAction ;
    ns1:exploits ns1:Vuln_CVE_2015_4852 ;
    ns1:instantiatesPattern ns1:AP_Deserialization .

ns1:Act_03 a ns1:ThreatAction ;
    ns1:exploits ns1:Vuln_CVE_2023_2065 ;
    ns1:instantiatesPattern ns1:AP_IDOR .

ns1:Act_04 a ns1:ThreatAction ;
    ns1:exploits ns1:Vuln_CVE_2023_34362 ;
    ns1:instantiatesPattern ns1:AP_SQLInjection .

ns1:Act_05 a ns1:ThreatAction ;
    ns1:exploits ns1:Vuln_CVE_2020_11022 ;
    ns1:instantiatesPattern ns1:AP_XSS .

ns1:Act_06 a ns1:ThreatAction ;
    ns1:exploits ns1:Vuln_CVE_2021_26855 ;
    ns1:instantiatesPattern ns1:AP_SSRF .

ns1:Act_CVE_2025_20337 a ns1:ThreatAction ;
    ns1:exploits ns1:Vuln_CVE_2025_20337 ;
    ns1:instantiatesPattern ns1:AP_T1106 .

ns1:Act_CVE_2025_21480 a ns1:ThreatAction ;
    ns1:exploits ns1:Vuln_CVE_2025_21480 ;
    ns1:instantiatesPattern ns1:AP_T1055 .

ns1:Act_CVE_2025_49706 a ns1:ThreatAction ;
    ns1:exploits ns1:Vuln_CVE_2025_49706 ;
    ns1:instantiatesPattern ns1:AP_T1190 .

ns1:Actor_UNK_E a ns1:ExternalActor ;
    rdfs:label "Ator externo nao atribuido E (ficticio)" .

ns1:Actor_Unknown_CVE_2025_20337 a ns1:UnknownActor ;
    rdfs:label "Ator desconhecido (KEV CVE-2025-20337)" .

ns1:Actor_Unknown_CVE_2025_21480 a ns1:UnknownActor ;
    rdfs:label "Ator desconhecido (KEV CVE-2025-21480)" .

