    rdfs:comment "Servidor de aplicacao." ;
    rdfs:subClassOf ns1:Asset .

ns1:cvssBaseScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "pontuacao base CVSS"@pt ;
    rdfs:comment "CVSS v3.x; funcional (um valor por vulnerabilidade)." ;
    rdfs:domain ns1:Vulnerability ;
    rdfs:range xsd:decimal .

ns1:ThreatActor a owl:Class ;
    rdfs:label "Ator de ameaca"@pt ;
    ns1:stixType "threat-actor" ;
    ns1:verisCategory "actor" ;
    rdfs:comment "Agente concreto que realiza a acao (VERIS: actor)." .

ns1:State_Confidentiality a ns1:SecurityState ;
    rdfs:label "Confidencialidade"@pt .

ns1:involvesVulnerability a owl:ObjectProperty ;
    rdfs:label "envolve vulnerabilidade"@pt ;
    rdfs:domain ns1:Incident ;
    rdfs:range ns1:Vulnerability .

ns1:v a ns2:Variable .

ns1:i2 a ns2:Variable .

ns1:Asset a owl:Class ;
    rdfs:label "Ativo"@pt ;
    ns1:stixType "infrastructure" ;
    ns1:verisCategory "asset" ;
    rdfs:comment "Recurso computacional afetado (VERIS: asset). Correspondencia aproximada com STIX infrastructure." .

ns1:s a ns2:Variable .

ns1:i1 a ns2:Variable .

ns1:ResolutionAction a owl:Class ;
    rdfs:label "Acao de resolucao"@pt ;
    rdfs:comment "Acao concreta registada como solucao de um caso." ;
    rdfs:subClassOf ns1:CourseOfAction .

ns1:Weakness a owl:Class ;
    rdfs:label "Fraqueza"@pt ;
    rdfs:comment "Entrada do catalogo CWE. As subclasses sao categorias definidas NESTE trabalho para similaridade; nao reproduzem a hierarquia oficial da CWE." .

ns1:ThreatAction a owl:Class ;
    rdfs:label "Acao de ameaca"@pt ;
    ns1:verisCategory "action" ;
    rdfs:comment "Acao concreta realizada num incidente (VERIS: action). Instancia um AttackPattern abstrato." .

ns1:i a ns2:Variable .

ns1:Case a owl:Class ;
    rdfs:label "Caso"@pt ;
    rdfs:comment "Caso CBR: par (incidente historico, acao de resolucao registada)." .

ns1:AttackPattern a owl:Class ;
    rdfs:label "Padrao de ataque"@pt ;
    ns1:stixType "attack-pattern" ;
    rdfs:comment "Tipo abstrato de ataque, reutilizavel entre incidentes; nao se liga a ativos concretos." .

ns1:Vulnerability a owl:Class ;
    rdfs:label "Vulnerabilidade"@pt ;
    ns1:stixType "vulnerability" ;
    rdfs:comment "Falha concreta num produto, identificada por CVE quando publica; liga-se a uma fraqueza (CWE)." .

ns1:Incident a owl:Class ;
    rdfs:label "Incident"@en,
        "Incidente"@pt ;
    ns1:stixType "incident" ;
    ns1:verisCategory "incident" ;
    rdfs:comment "Evento de seguranca reificado; liga-se aos quatro eixos VERIS A4: ator, acao, ativo e atributo." .

[] a owl:AllDifferent ;
    owl:distinctMembers ( ns1:Incident_01 ns1:Incident_02 ns1:Incident_03 ns1:Incident_04 ns1:Incident_05 ns1:Incident_06 ns1:Incident_CVE_2025_20337 ns1:Incident_CVE_2025_21480 ns1:Incident_CVE_2025_49706 ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:ExternalActor ns1:InternalActor ns1:PartnerActor ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:Server ns1:Database ns1:Gateway ns1:Workstation ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:InjectionWeakness ns1:WebClientWeakness ns1:AccessControlWeakness ns1:AuthenticationWeakness ns1:ResourceHandlingWeakness ns1:RequestForgeryWeakness ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:Incident ns1:ThreatActor ns1:ThreatAction ns1:AttackPattern ns1:Asset ns1:SecurityState ns1:Vulnerability ns1:Weakness ns1:DetectionSource ns1:CourseOfAction ns1:Case ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:ExternalActor ns1:InternalActor ns1:PartnerActor ns1:UnknownActor ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:InjectionWeakness ns1:WebClientWeakness ns1:AccessControlWeakness ns1:AuthenticationWeakness ns1:ResourceHandlingWeakness ns1:RequestForgeryWeakness ns1:MemorySafetyWeakness ns1:OtherWeakness ) .

