    rdfs:label "Fraqueza do lado do cliente web"@pt ;
    rdfs:comment "CWE-79, CWE-352." ;
    rdfs:subClassOf ns1:Weakness .

ns1:a a ns2:Variable .

ns1:v1 a ns2:Variable .

ns1:v2 a ns2:Variable .

