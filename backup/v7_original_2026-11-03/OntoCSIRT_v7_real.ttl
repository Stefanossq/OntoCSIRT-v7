ns1:actor a ns2:Variable .

ns1:hasActor a owl:ObjectProperty ;
    rdfs:label "tem ator"@pt ;
    rdfs:comment "VERIS: quem realizou." ;
    rdfs:domain ns1:Incident ;
    rdfs:range ns1:ThreatActor .

ns1:hasAsset a owl:ObjectProperty ;
    rdfs:label "tem ativo"@pt ;
    rdfs:comment "VERIS: ativo afetado." ;
    rdfs:domain ns1:Incident ;
    rdfs:range ns1:Asset ;
    owl:inverseOf ns1:isAssetOf .

ns1:hasWeakness a owl:ObjectProperty ;
    rdfs:label "tem fraqueza"@pt ;
    rdfs:domain ns1:Vulnerability ;
    rdfs:range ns1:Weakness .

