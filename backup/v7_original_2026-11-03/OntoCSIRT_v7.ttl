# Incidentes distintos entre si (o raciocinador nao assume nomes unicos; necessario para differentFrom)
[] a owl:AllDifferent ; owl:distinctMembers ( :Incident_01 :Incident_02 :Incident_03 :Incident_04 :Incident_05
    :Incident_06 :Incident_07 :Incident_08 :Incident_09 :Incident_10 :Incident_11 :Incident_12 :Incident_13
    :Incident_14 :Incident_15 :Incident_16 :Incident_17 :Incident_18 :Incident_19 :Incident_20 :Incident_21
    :Incident_22 :Incident_23 :Incident_24 ) .

#############################################################################
# 8. REGRAS SWRL (unica fonte das regras; o script nao as redefine)
#############################################################################
:i a swrl:Variable . :i1 a swrl:Variable . :i2 a swrl:Variable . :j a swrl:Variable .
:v a swrl:Variable . :v1 a swrl:Variable . :v2 a swrl:Variable . :w a swrl:Variable . :s1 a swrl:Variable . :s2 a swrl:Variable .
:s a swrl:Variable . :a a swrl:Variable . :actor a swrl:Variable . :c a swrl:Variable . :sol a swrl:Variable .

# R1a: Incident(?i) ^ involvesVulnerability(?i,?v) ^ cvssBaseScore(?v,?s) ^ swrlb:greaterThanOrEqual(?s,9.0) -> hasRiskLevel(?i,"Critical")
:R1a_Critical a swrl:Imp ; rdfs:label "R1a - CVSS >= 9.0 implica risco Critical" ;
  swrl:body ( [ a swrl:ClassAtom ; swrl:classPredicate :Incident ; swrl:argument1 :i ]
              [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :involvesVulnerability ; swrl:argument1 :i ; swrl:argument2 :v ]
              [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :cvssBaseScore ; swrl:argument1 :v ; swrl:argument2 :s ]
              [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( :s "9.0"^^xsd:decimal ) ] ) ;
  swrl:head ( [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :hasRiskLevel ; swrl:argument1 :i ; swrl:argument2 "Critical" ] ) .

# R1b: ... ^ swrlb:greaterThanOrEqual(?s,7.0) ^ swrlb:lessThan(?s,9.0) -> hasRiskLevel(?i,"High")
:R1b_High a swrl:Imp ; rdfs:label "R1b - 7.0 <= CVSS < 9.0 implica risco High" ;
  swrl:body ( [ a swrl:ClassAtom ; swrl:classPredicate :Incident ; swrl:argument1 :i ]
              [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :involvesVulnerability ; swrl:argument1 :i ; swrl:argument2 :v ]
              [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :cvssBaseScore ; swrl:argument1 :v ; swrl:argument2 :s ]
              [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( :s "7.0"^^xsd:decimal ) ]
              [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThan ; swrl:arguments ( :s "9.0"^^xsd:decimal ) ] ) ;
  swrl:head ( [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :hasRiskLevel ; swrl:argument1 :i ; swrl:argument2 "High" ] ) .

# R1c: 4.0 <= CVSS < 7.0 -> "Medium"
:R1c_Medium a swrl:Imp ; rdfs:label "R1c - 4.0 <= CVSS < 7.0 implica risco Medium" ;
  swrl:body ( [ a swrl:ClassAtom ; swrl:classPredicate :Incident ; swrl:argument1 :i ]
              [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :involvesVulnerability ; swrl:argument1 :i ; swrl:argument2 :v ]
              [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :cvssBaseScore ; swrl:argument1 :v ; swrl:argument2 :s ]
              [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( :s "4.0"^^xsd:decimal ) ]
              [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThan ; swrl:arguments ( :s "7.0"^^xsd:decimal ) ] ) ;
  swrl:head ( [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :hasRiskLevel ; swrl:argument1 :i ; swrl:argument2 "Medium" ] ) .

# R1d: CVSS < 4.0 -> "Low"
:R1d_Low a swrl:Imp ; rdfs:label "R1d - CVSS < 4.0 implica risco Low" ;
  swrl:body ( [ a swrl:ClassAtom ; swrl:classPredicate :Incident ; swrl:argument1 :i ]
              [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :involvesVulnerability ; swrl:argument1 :i ; swrl:argument2 :v ]
              [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :cvssBaseScore ; swrl:argument1 :v ; swrl:argument2 :s ]
              [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThan ; swrl:arguments ( :s "4.0"^^xsd:decimal ) ] ) ;
  swrl:head ( [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :hasRiskLevel ; swrl:argument1 :i ; swrl:argument2 "Low" ] ) .

# R3: Asset(?a) ^ hasAsset(?i1,?a) ^ involvesVulnerability(?i1,?v1) ^ cvssBaseScore(?v1,?s1) ^ swrlb:greaterThanOrEqual(?s1,9.0)
#     ^ hasAsset(?i2,?a) ^ involvesVulnerability(?i2,?v2) ^ cvssBaseScore(?v2,?s2) ^ swrlb:greaterThanOrEqual(?s2,9.0)
#     ^ differentFrom(?i1,?i2) -> RecurrentlyCriticalAsset(?a)
# (le o CVSS diretamente; uma versao que usava a classe definida CriticalRiskIncident no corpo deixava o
#  Pellet 2.3.1 sem emitir os valores de R1 em alguns dados - ver artigo, Secao 5)
:R3_RecurrentCritical a swrl:Imp ; rdfs:label "R3 - ativo com dois ou mais incidentes criticos distintos" ;
  swrl:body ( [ a swrl:ClassAtom ; swrl:classPredicate :Asset ; swrl:argument1 :a ]
              [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasAsset ; swrl:argument1 :i1 ; swrl:argument2 :a ]
              [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :involvesVulnerability ; swrl:argument1 :i1 ; swrl:argument2 :v1 ]
              [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :cvssBaseScore ; swrl:argument1 :v1 ; swrl:argument2 :s1 ]
              [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( :s1 "9.0"^^xsd:decimal ) ]
              [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasAsset ; swrl:argument1 :i2 ; swrl:argument2 :a ]
              [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :involvesVulnerability ; swrl:argument1 :i2 ; swrl:argument2 :v2 ]
              [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :cvssBaseScore ; swrl:argument1 :v2 ; swrl:argument2 :s2 ]
              [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( :s2 "9.0"^^xsd:decimal ) ]
              [ a swrl:DifferentIndividualsAtom ; swrl:argument1 :i1 ; swrl:argument2 :i2 ] ) ;
  swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate :RecurrentlyCriticalAsset ; swrl:argument1 :a ] ) .

# R4: hasActor(?i1,?actor) ^ hasActor(?i2,?actor) ^ differentFrom(?i1,?i2) -> sharesActorWith(?i1,?i2)
:R4_SharedActor a swrl:Imp ; rdfs:label "R4 - incidentes com o mesmo ator concreto" ;
  swrl:body ( [ a swrl:ClassAtom ; swrl:classPredicate :Incident ; swrl:argument1 :i1 ]
              [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasActor ; swrl:argument1 :i1 ; swrl:argument2 :actor ]
              [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasActor ; swrl:argument1 :i2 ; swrl:argument2 :actor ]
              [ a swrl:DifferentIndividualsAtom ; swrl:argument1 :i1 ; swrl:argument2 :i2 ] ) ;
  swrl:head ( [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :sharesActorWith ; swrl:argument1 :i1 ; swrl:argument2 :i2 ] ) .

# R5: involvesVulnerability(?i1,?v1) ^ hasWeakness(?v1,?w) ^ involvesVulnerability(?i2,?v2) ^ hasWeakness(?v2,?w) ^ differentFrom(?i1,?i2) -> sharesWeaknessWith(?i1,?i2)
:R5_SharedWeakness a swrl:Imp ; rdfs:label "R5 - incidentes com a mesma fraqueza (CWE)" ;
  swrl:body ( [ a swrl:ClassAtom ; swrl:classPredicate :Incident ; swrl:argument1 :i1 ]
              [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :involvesVulnerability ; swrl:argument1 :i1 ; swrl:argument2 :v1 ]
              [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasWeakness ; swrl:argument1 :v1 ; swrl:argument2 :w ]
              [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :involvesVulnerability ; swrl:argument1 :i2 ; swrl:argument2 :v2 ]
              [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasWeakness ; swrl:argument1 :v2 ; swrl:argument2 :w ]
              [ a swrl:DifferentIndividualsAtom ; swrl:argument1 :i1 ; swrl:argument2 :i2 ] ) ;
  swrl:head ( [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :sharesWeaknessWith ; swrl:argument1 :i1 ; swrl:argument2 :i2 ] ) .

# R6: sharesWeaknessWith(?i,?j) ^ hasProblem(?c,?j) ^ hasSolution(?c,?sol) -> candidateSolution(?i,?sol)
:R6_CandidateSolution a swrl:Imp ; rdfs:label "R6 - solucao de caso com a mesma fraqueza e candidata" ;
  swrl:body ( [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :sharesWeaknessWith ; swrl:argument1 :i ; swrl:argument2 :j ]
              [ a swrl:ClassAtom ; swrl:classPredicate :Case ; swrl:argument1 :c ]
              [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasProblem ; swrl:argument1 :c ; swrl:argument2 :j ]
              [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasSolution ; swrl:argument1 :c ; swrl:argument2 :sol ] ) ;
  swrl:head ( [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :candidateSolution ; swrl:argument1 :i ; swrl:argument2 :sol ] ) .
